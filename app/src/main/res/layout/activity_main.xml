<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:padding="18dp">
    <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:text="RB CONSULTING" android:textStyle="bold" android:textSize="28sp" android:textColor="#0B2D5C" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:text="Gestion des dépenses" android:textSize="19sp" android:layout_marginBottom="16dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <Button android:id="@+id/importPhotos" android:text="Importer plusieurs photos" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Button android:id="@+id/takePhoto" android:text="Prendre des photos en série" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/queueCount" android:text="0 justificatif en attente" android:textStyle="bold" android:layout_marginTop="14dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/queuePreview" android:text="Importez ou photographiez vos justificatifs." android:layout_marginTop="6dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Button android:id="@+id/validateAll" android:text="VALIDER LES JUSTIFICATIFS" android:enabled="false" android:layout_marginTop="14dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Button android:id="@+id/clearQueue" android:text="Vider la sélection" android:enabled="false" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:text="Période comptable" android:textStyle="bold" android:textSize="18sp" android:layout_marginTop="22dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <EditText android:id="@+id/periodName" android:hint="Ex. Août 2026" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/chfTotal" android:text="Dépenses CHF : 0.00 CHF" android:textSize="19sp" android:textStyle="bold" android:layout_marginTop="18dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/eurTotal" android:text="Dépenses EUR : 0.00 EUR" android:textSize="19sp" android:textStyle="bold" android:layout_marginTop="6dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:text="Tickets validés" android:textSize="18sp" android:textStyle="bold" android:layout_marginTop="22dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/result" android:text="Aucun ticket validé." android:layout_marginTop="6dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Button android:id="@+id/exportPdf" android:text="Exporter / clôturer la période" android:layout_marginTop="18dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Button android:id="@+id/archive" android:text="Archives" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    </LinearLayout>
</ScrollView>
